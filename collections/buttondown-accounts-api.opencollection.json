{
  "opencollection": "1.0.0",
  "info": {
    "name": "Buttondown Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
