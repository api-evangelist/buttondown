{
  "opencollection": "1.0.0",
  "info": {
    "name": "Buttondown Ping API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.buttondown.com/v1/ping"
          },
          "docs": "Check if the API is reachable and your credentials are valid"
        }
      ]
    }
  ],
  "bundled": true
}