{
  "opencollection": "1.0.0",
  "info": {
    "name": "Buttondown public API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "public",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search public emails",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.buttondown.com/v1/public/emails/:username",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "If provided, only return emails matching the given query."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to return."
              }
            ]
          },
          "docs": "Search and list public emails for a newsletter. No authentication required."
        }
      ]
    }
  ],
  "bundled": true
}